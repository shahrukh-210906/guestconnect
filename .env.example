PORT=3001
# Paste the Atlas Drivers connection string here, with database name guestconnect.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/guestconnect?retryWrites=true&w=majority
# Set a secret before exposing the API. Enter it in the app Settings.
API_KEY=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GuestConnect <events@example.edu>

# Optional server-side NeuroLog integration
NEUROLOG_ENDPOINT=https://neurolog-ai.onrender.com/api/ingest
NEUROLOG_INGEST_KEY=
